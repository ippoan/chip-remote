  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20260630.1",
    "@vitest/coverage-istanbul": "^3.2.4",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "wrangler": "~4.106.0"
  }
}
