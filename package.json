{
  "name": "chip-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Claude desktop の spawn_task chip を Android 通知から起動・非表示する中継 (Hono Worker + HubDO + FCM + Windows agent WS)。",
  "scripts": {
