{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chip-remote-agent",
  "version": "0.1.0",
  "identifier": "org.ippoan.chipremote.agent",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "chip-remote agent",
    "longDescription": "Presses spawn_task chips in Claude desktop on request from the chip-remote phone app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ippoan/chip-remote/releases/download/agent-latest/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
